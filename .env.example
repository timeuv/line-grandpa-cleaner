# ==========================================
# LINE Messaging API Credentials
# ==========================================
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ==========================================
# Public Base URL (จำเป็นสำหรับส่งรูปกลับเข้า LINE)
# ==========================================
BASE_URL=https://your-public-url.hf.space

# ==========================================
# Text Removal AI Engine Selection
# ==========================================
# ตัวเลือก: 'auto', 'clipdrop', 'snapedit', 'local_stroke'
# - 'auto': ถ้ามีคีย์ ClipDrop/SnapEdit จะใช้ตัวนั้นก่อน ถ้าไม่มีจะใช้ local_stroke ให้อัตโนมัติ
TEXT_REMOVAL_ENGINE=auto

# [ตัวเลือกที่ 1] ClipDrop API (เนียนระดับสตูดิโอ 10/10)
# สมัครรับฟรีได้ที่: https://clipdrop.co/apis
CLIPDROP_API_KEY=

# [ตัวเลือกที่ 2] SnapEdit API (เชี่ยวชาญภาษาไทย/เอเชีย 9.5/10)
# สมัครรับฟรีได้ที่: https://developer.snapedit.app
SNAPEDIT_API_KEY=

# ==========================================
# AI Conversation Settings (Optional)
# ==========================================
# ฟรีจาก https://aistudio.google.com
GEMINI_API_KEY=

PORT=7860
